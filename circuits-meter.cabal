cabal-version: 3.0
name: circuits-meter
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: performance
synopsis: Performance measurement as a Circuit
description:
  Performance measurement reimagined as a traced monoidal category.
  A 'Meter' captures state before a computation and observes it
  after. 'meterAction' sandwiches an arrow between the two, giving
  a 'Circuit' polymorphic in its tensor. Time and allocation meters
  compose in parallel via 'both'. Includes a benchmark exercising
  the public runners against IORef and delimited-continuation controls.

extra-doc-files:
  readme.md

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-meter.git

library
  exposed-modules:
    Circuit.Meter
    Circuit.Meter.Space
    Circuit.Meter.Stopwatch
    Circuit.Meter.Time

  build-depends:
    base >=4.20 && <5,
    circuits >=0.1 && <0.5,
    clock >=0.8 && <0.9,
    containers >=0.6 && <0.9,
    deepseq >=1.4 && <1.6,
    profunctors >=5.6 && <5.7,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

executable circuits-meter-axioma
  main-is: axioma.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    circuits-meter,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -rtsopts
