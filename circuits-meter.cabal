cabal-version: 3.0
name: circuits-meter
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: performance
synopsis: Performance measurement as a Circuit
description:
  Performance measurement reimagined as a traced monoidal category.
  A 'Meter' captures state before a computation and observes it
  after. 'meterAction' sandwiches an arrow between the two, giving
  a 'Circuit' polymorphic in its tensor. Time and allocation meters
  compose in parallel via 'both'. Includes a benchmark exercising
  the public runners against IORef and delimited-continuation controls.

extra-doc-files:
  readme.md

build-type: Simple
tested-with:
  ghc ==9.14.1,
  ghc ==9.12.2,
  ghc ==9.10.1

library
  exposed-modules:
    Circuit.Meter
    Circuit.Meter.Time
    Circuit.Meter.Space

  build-depends:
    base >=4.20 && <5,
    circuits >=0.1 && <0.4,
    clock >=0.8 && <0.9,
    deepseq >=1.4 && <1.6,
    profunctors >=5.6 && <5.7,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

executable perf-bench
  main-is: Main.hs
  hs-source-dirs: app

  build-depends:
    base >=4.20 && <5,
    circuits >=0.1 && <0.4,
    circuits-meter,
    clock >=0.8 && <0.9,
    deepseq >=1.4 && <1.6,
    optparse-applicative >=0.18 && <0.19,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -O2
    -rtsopts

executable baseline
  main-is: Baseline.hs
  hs-source-dirs: examples

  build-depends:
    base >=4.20 && <5,
    chart-svg >=0.8 && <0.9,
    circuits-meter,
    deepseq >=1.4 && <1.6,
    directory >=1.3 && <1.5,
    filepath >=1.4 && <1.6,
    numhask-space >=0.10 && <0.14,
    optics-core >=0.4 && <0.5,
    optparse-applicative >=0.18 && <0.19,
    prettychart,
    tdigest >=0.2 && <0.4,
    text >=2.0 && <2.2,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -O2
    -rtsopts
