cabal-version: 3.0
name: circuits-meter
version: 0.1.0.0
license: BSD-3-Clause
author: Tony Day
maintainer: tonyday567@gmail.com
category: performance
synopsis: Performance measurement as a Circuit
description:
  Performance measurement reimagined as a traced monoidal category.
  'Meter' is a state wire introduced before a computation and read
  after: 'initK' creates the state, 'termK' observes it. Time, space,
  and combined meters compose sequentially and in parallel via the
  cartesian tensor. Includes a benchmark comparing circuit-based
  measurement against IORef control groups.
build-type: Simple
tested-with:
  ghc ==9.14.1,
  ghc ==9.12.2,
  ghc ==9.10.1

library
  exposed-modules:
    Circuit.Meter
    Circuit.Meter.Time
    Circuit.Meter.Space

  build-depends:
    base >=4.20 && <5,
    circuits >=0.1 && <0.2,
    clock >=0.8 && <0.9,
    deepseq >=1.4 && <1.6,
    profunctors >=5.6 && <5.7,
    text >=2.0 && <2.2,

  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat

executable perf-bench
  main-is: Main.hs
  hs-source-dirs: app

  build-depends:
    base >=4.20 && <5,
    circuits >=0.1 && <0.2,
    circuits-meter,
    clock >=0.8 && <0.9,
    deepseq >=1.4 && <1.6,
    optparse-applicative >=0.18 && <0.19,
    text >=2.0 && <2.2,

  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -O2
    -rtsopts
