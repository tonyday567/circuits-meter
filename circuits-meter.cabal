cabal-version: 3.0
name: circuits-meter
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: performance
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-meter#readme
bug-reports: https://github.com/tonyday567/circuits-meter/issues
synopsis: Input-seeded and pipeline performance measurement
description:
  Performance measurement as an input-seeded 'Circuit.Machine.Body'.
  Repeated runners preserve first-input and final-emission semantics.
  Time and RTS allocation observations retain chronological samples and
  the latest result. Pipeline markers add labelled laps and a directly
  measured enclosing total to an actual circuit execution.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

extra-doc-files:
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-meter.git

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  default-language: GHC2024
  exposed-modules:
    Circuit.Meter

  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,
    clock >=0.8 && <0.9,
    containers >=0.6 && <0.9,
    text >=2.1 && <2.2,

  hs-source-dirs: src
  ghc-options:
    -Wall
    -Wcompat

executable circuits-meter-axioma
  default-language: GHC2024
  main-is: axioma.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    circuits,
    circuits-meter,
    containers,

  ghc-options:
    -Wall
    -Wcompat
    -rtsopts
